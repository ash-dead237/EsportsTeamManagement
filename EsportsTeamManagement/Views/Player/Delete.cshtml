@model EsportsTeamManagement.Models.Player

<h2>Delete Player</h2>

<h4>Are you sure you want to delete this player?</h4>

<hr />

<p>
    <strong>Name:</strong>
    @Model.PlayerName
</p>

<p>
    <strong>Country:</strong>
    @Model.Country
</p>

<p>
    <strong>Role:</strong>
    @Model.GameRole
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="PlayerId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
    <a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

</form>