@model EsportsTeamManagement.Models.MatchDetail

<h2>Delete Match</h2>

<p>
    Are you sure you want to delete this match?
</p>

<p>
    @Model.Team1?.TeamName vs @Model.Team2?.TeamName
</p>

<form method="post">

    <input type="hidden"
           asp-for="MatchId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

</form>