@model List<EsportsTeamManagement.Models.MatchDetail>

<!-- Header Section with Title and Dashboard (Back) Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Matches</h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-dark">
        Dashboard
    </a>
</div>

<!-- Primary Actions Row -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        Schedule Match
    </a>
</div>

<!-- Updated Table Grid with Action Buttons -->
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Tournament</th>
                <th>Team 1</th>
                <th>Team 2</th>
                <th>Winner</th>
                <th>Date</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var match in Model)
            {
                <tr>
                    <td>@match.Tournament?.TournamentName</td>
                    <td class="fw-bold">@match.Team1?.TeamName</td>
                    <td class="fw-bold">@match.Team2?.TeamName</td>
                    <td>@(match.WinnerTeam?.TeamName ?? "TBD / Draw")</td>
                    <td>@match.MatchDate</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@match.MatchId" class="btn btn-info text-white">
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@match.MatchId" class="btn btn-warning">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@match.MatchId" class="btn btn-danger">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
