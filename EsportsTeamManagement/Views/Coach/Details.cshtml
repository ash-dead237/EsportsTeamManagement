@model EsportsTeamManagement.Models.Coach

<h2>Coach Details</h2>

<hr />

<div class="card">
    <div class="card-body">

        <h4>@Model.CoachName</h4>

        <p>
            <strong>Experience:</strong>
            @Model.ExperienceYears Years
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

    </div>
</div>

<br />
<hr />

<h4>Teams Coached</h4>

@if(Model.Teams.Any())
{
    <ul>

    @foreach(var team in Model.Teams)
    {
        <li>@team.TeamName</li>
    }

    </ul>
}
else
{
    <p>No teams assigned.</p>
    }


<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>