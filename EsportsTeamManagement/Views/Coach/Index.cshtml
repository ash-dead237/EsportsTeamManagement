@model List<EsportsTeamManagement.Models.Coach>

<!-- Header Section with Title and Dashboard (Back) Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Coaches</h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-dark">
        Dashboard
    </a>
</div>

<!-- Primary Actions Row -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        Add Coach
    </a>
</div>

<!-- Updated Table Grid with Action Buttons -->
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Experience</th>
                <th>Email</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var coach in Model)
            {
                <tr>
                    <td class="fw-bold">@coach.CoachName</td>
                    <td>@coach.ExperienceYears Years</td>
                    <td>@coach.Email</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@coach.CoachId" class="btn btn-info text-white">
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@coach.CoachId" class="btn btn-warning">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@coach.CoachId" class="btn btn-danger">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
