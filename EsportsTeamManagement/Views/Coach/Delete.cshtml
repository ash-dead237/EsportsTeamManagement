@model EsportsTeamManagement.Models.Coach

<h2>Delete Coach</h2>

<h4>Are you sure you want to delete this coach?</h4>

<hr />

<p>
    <strong>Name:</strong>
    @Model.CoachName
</p>

<p>
    <strong>Experience:</strong>
    @Model.ExperienceYears Years
</p>

<p>
    <strong>Email:</strong>
    @Model.Email
</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="CoachId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>