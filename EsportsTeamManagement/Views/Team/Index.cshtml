@model List<EsportsTeamManagement.Models.Team>

<!-- Header Section with Title and Dashboard (Back) Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Teams</h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Dashboard
    </a>
</div>

<!-- Primary Actions Row -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add Team
    </a>
</div>

<!-- Updated Table Grid with Action Buttons -->
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Team Name</th>
                <th>Region</th>
                <th>Coach</th>
                <th style="width: 220px;">Actions</th> 
            </tr>
        </thead>
        <tbody>
            @foreach(var team in Model)
            {
                <tr>
                    <td class="fw-bold">@team.TeamName</td>
                    <td>@team.Region</td>
                    <td>@(team.Coach?.CoachName ?? "No Coach Assigned")</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@team.TeamId" class="btn btn-info text-white">
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@team.TeamId" class="btn btn-warning">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@team.TeamId" class="btn btn-danger">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
