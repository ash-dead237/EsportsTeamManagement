@model EsportsTeamManagement.ViewModels.TeamViewModel

<h2>Create Team</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Team Name</label>
        <input asp-for="TeamName" class="form-control" />
    </div>

    <br />

    <div>
        <label>Region</label>
        <input asp-for="Region" class="form-control" />
    </div>

    <br />
    <div class="mb-3">

    <label>Coach</label>
@*below select tag is used to create a dropdown list for selecting a coach from the available coaches in the model. 
The asp-for attribute binds the selected value to the CoachId property of the model,
and the asp-items attribute populates the dropdown with the list of coaches provided in the Model.Coaches collection. 
The first option is a placeholder prompting the user to select a coach.*@
    <select asp-for="CoachId"
            asp-items="Model.Coaches"
            class="form-control">

        <option value="">
            Select Coach
        </option>

    </select>

</div>

    <button type="submit" class="btn btn-primary">
        Save Team
    </button>
    <a asp-action="Index"
class="btn btn-secondary">
Back
</a>

</form>
@*
//asp-for is used to bind the input fields to the properties of the model,allowing  for automatic data 
//binding and validation when the form is submitted.
//asp-items is used to populate the dropdown list with the available coaches from the model.
//asp-action is used to specify the action method in the controller that will handle the form submission.
*@