@model EsportsTeamManagement.ViewModels.LoginViewModel

<h2>Login</h2>

<form method="post">

    <div>
        <label>Username</label>
        <input asp-for="Username" />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Login
    </button>

</form>

@if(ViewBag.Error != null)
{
    <p style="color:red">
        @ViewBag.Error
    </p>
}