@model EsportsTeamManagement.ViewModels.LoginViewModel

<div style="display: flex; justify-content: center; align-items: center; min-height: 80vh;">
    <div style="border: 1px solid black; padding: 20px; border-radius: 4px;">
        <h2>Login</h2>

        <form method="post">

            <div>
                <label>Username</label>
                <input asp-for="Username" />
            </div>

            <br />

            <div>
                <label>Password</label>
                <input asp-for="Password" type="password" />
            </div>

            <br />

            <button type="submit">
                Login
            </button>

        </form>

        @if(ViewBag.Error != null)
        {
            <p style="color:red">
                @ViewBag.Error
            </p>
        }
    </div>
</div>
