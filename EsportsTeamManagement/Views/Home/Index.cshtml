@{
    ViewData["Title"] = "Esports Portal Home";
}

<div class="py-4">
    <!-- Hero Header Banner Section -->
    <div class="p-5 mb-4 bg-dark text-white rounded-3 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e1b4b 0%, #311042 100%);">
        <div class="container-fluid py-3 position-relative" style="z-index: 2;">
            <span class="badge bg-danger mb-2 text-uppercase tracking-wider px-3 py-2 fw-bold">Live Hub Control</span>
            <h1 class="display-5 fw-bold">Esports Management Portal</h1>
            <p class="col-md-8 fs-5 text-gray-300">Track professional team structures, manage active roster players, audit tournament statistics, and review top leaderboards in real-time.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 me-2 fw-bold border-0" style="background-color: #6366f1;">Launch Dashboard</a>
        </div>
        <!-- Subtle subtle geometric background design accents -->
        <div class="position-absolute end-0 top-0 bottom-0 d-none d-md-block" style="width: 40%; background: linear-gradient(90deg, transparent, rgba(99,102,241,0.15)); transform: skewX(-15deg) translateX(50px);"></div>
    </div>
    <!-- Replace the Quick Stat Cards Section with this Feature CTA -->
<div class="card border-0 shadow-sm bg-white p-4 mb-5">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="fw-bold text-dark mb-2">Ready to take command of your squad data?</h4>
            <p class="text-muted mb-0">Unlock granular profile insights, tournament layout registration forms, and historical team tracking utilities by joining today.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Account" asp-action="Register" class="btn btn-dark btn-lg px-4 py-2 fw-semibold">Sign Up Now</a>
        </div>
    </div>
</div>

